---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PortableText } from 'astro-portabletext';
import { getSiteSettings } from '../utils/sanity';

const settings = await getSiteSettings();
const hero = settings?.hero ?? {};

const logoUrl = hero.logo?.asset?.url || '/odff-main-logo.png';
const logoAlt = hero.logo?.alt || 'Ojai Documentary Film Festival — October 26–30, Ojai, California. Presented by Hotel El Roblar & Ojai Playhouse.';

const fallbackHeroImages = ['01', '02', '03', '04', '05', '07', '08'].map((n) => ({
  asset: { url: `/hero/hero-${n}.png` },
  alt: '',
}));
const heroImages = hero.images?.length ? hero.images : fallbackHeroImages;

const fallbackBodyText =
  "The Ojai Documentary Film Festival presented by Hotel El Roblar and the Ojai Playhouse Theater will take place October 27–30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect. Together, we explore nonfiction storytelling from vérité and hybrid forms to the wholly unclassifiable, spanning the contemporary and the nostalgic, transforming real life into cinema that's anything but boring.";

const fallbackSchedule = [
  {
    dayLabel: 'Monday, October 26',
    screenings: [
      { time: '1 PM', title: 'The Story of Documentary Film: Chapters 1-3' },
      { time: '5 PM', title: 'Musk' },
    ],
  },
  {
    dayLabel: 'Tuesday, October 27',
    screenings: [
      { time: '12 PM', title: 'Punishment Park', note: 'Q&A with director Joan Churchill' },
      { time: '2:30 PM', title: 'Rehearsals for a Revolution' },
      { time: '4:30 PM', title: 'Everest: The Other Side' },
      { time: '7 PM', title: 'Nuisance Bear', note: 'Q&A with directors Jack Weisman & Joan Churchill' },
    ],
  },
  {
    dayLabel: 'Wednesday, October 28',
    screenings: [
      { time: '2:30 PM', title: 'Remake' },
      { time: '4:30 PM', title: 'Bend in the River', note: 'Q&A with directors Robb Moss & Lauren Greenfield' },
      { time: '7:30 PM', title: 'Jean-Michel' },
      { time: '9:15 PM', title: 'Wild Combination: A Portrait of Arthur Russell', note: 'Intro by director Matt Wolf' },
    ],
  },
  {
    dayLabel: 'Thursday, October 29',
    screenings: [
      { time: '12:00 PM', title: 'Queen of Versailles', note: 'Q&A with director Lauren Greenfield' },
      { time: '2:00 PM', title: 'Barbara Forever' },
      { time: '4:15 PM', title: 'The History of Concrete' },
      { time: '7:00 PM', title: 'You Can See Everything', note: 'Q&A with Ari Balouzian (composer)' },
    ],
  },
  {
    dayLabel: 'Friday, October 30',
    screenings: [
      { time: '12:00 PM', title: 'Boatbuilders' },
      { time: '2:15 PM', title: 'Soul Patrol' },
      { time: '5:00 PM', title: 'Once Upon a Time in Harlem' },
      { time: '7:30 PM', title: 'The Best Summer', note: 'Q&A with director Tamra Davis' },
    ],
  },
];

const schedule = settings?.schedule?.length ? settings.schedule : fallbackSchedule;
---

<SiteLayout title="Ojai Documentary Film Festival">
      <section class="festival-logo">
        <img src={logoUrl} alt={logoAlt} class="festival-logo-img" />
      </section>

      <section class="hero-carousel" data-carousel>
        {heroImages.map((image: any, i: number) => (
          <img
            src={image.asset?.url}
            alt={image.alt || ''}
            class="hero-carousel-slide"
            data-active={i === 0 ? 'true' : 'false'}
          />
        ))}

        {heroImages.length > 1 && (
          <div class="hero-carousel-dots">
            {heroImages.map((_: any, i: number) => (
              <button
                type="button"
                class="hero-carousel-dot"
                data-index={i}
                aria-label={`Show photo ${i + 1}`}
              />
            ))}
          </div>
        )}
      </section>

      <section class="description">
        {hero.body ? <PortableText value={hero.body} /> : <p>{fallbackBodyText}</p>}
      </section>

      <section class="schedule">
        <h2 class="schedule-heading">Schedule</h2>

        {schedule.map((day: any) => (
          <div class="schedule-day">
            <div class="schedule-rule schedule-rule-top"></div>
            <h3 class="schedule-day-label">{day.dayLabel}</h3>
            <div class="schedule-rule schedule-rule-bottom"></div>

            {day.screenings?.map((screening: any) => (
              <div class="screening">
                <p class="screening-time">{screening.time}</p>
                {screening.url ? (
                  <a href={screening.url} class="screening-title" target="_blank" rel="noopener">
                    {screening.title}
                  </a>
                ) : (
                  <p class="screening-title">{screening.title}</p>
                )}
                {screening.note && <p class="screening-note">{screening.note}</p>}
              </div>
            ))}
          </div>
        ))}
      </section>
</SiteLayout>

<script>
      document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-carousel-slide'));
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-carousel-dot'));
        if (slides.length <= 1) return;

        let index = 0;
        let timer: ReturnType<typeof setInterval>;

        function show(next: number) {
          index = next;
          slides.forEach((slide, i) => slide.setAttribute('data-active', String(i === index)));
          dots.forEach((dot, i) => dot.setAttribute('data-active', String(i === index)));
        }

        function restart() {
          clearInterval(timer);
          timer = setInterval(() => show((index + 1) % slides.length), 5000);
        }

        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            show(i);
            restart();
          });
        });

        show(0);
        restart();
      });
</script>
