---
import { getSiteSettings, urlFor } from '../utils/sanity';
import { PortableText } from 'astro-portabletext';

const settings = await getSiteSettings();

const header = settings?.header ?? {};
const hero = settings?.hero ?? {};
const footer = settings?.footer ?? {};

const headerBadgeUrl = header.headerBadge?.asset ? urlFor(header.headerBadge).url() : null;
const monogramUrl = hero.monogram?.asset ? urlFor(hero.monogram).url() : null;
const botanicalUrl = hero.botanicalIllustration?.asset ? urlFor(hero.botanicalIllustration).url() : null;
const contactEmail = footer.contactEmail ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{hero.title ?? 'odff'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Special+Elite&family=Archivo:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="header-nav">
        {header.buyTicketsUrl ? (
          <a href={header.buyTicketsUrl} class="header-link" target="_blank" rel="noopener">
            {header.buyTicketsLabel}
          </a>
        ) : (
          <span class="header-link">{header.buyTicketsLabel}</span>
        )}

        <span class="header-badge" aria-hidden="true">
          {headerBadgeUrl ? (
            <img src={headerBadgeUrl} alt={header.headerBadge?.alt ?? ''} class="badge-img" />
          ) : (
            <svg viewBox="0 0 64 64" class="badge-fallback" role="img" aria-label="Festival badge">
              <circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M20 14 a14 14 0 0 1 24 0" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M20 14 l-4 18 a16 16 0 0 0 32 0 l-4 -18" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="32" cy="28" r="2" fill="currentColor" />
            </svg>
          )}
        </span>

        {header.bookRoomUrl ? (
          <a href={header.bookRoomUrl} class="header-link" target="_blank" rel="noopener">
            {header.bookRoomLabel}
          </a>
        ) : (
          <span class="header-link">{header.bookRoomLabel}</span>
        )}
      </nav>
    </header>

    <main class="hero">
      <div class="hero-meta">
        <span class="meta-text">{hero.dateRange}</span>

        <span class="hero-monogram" aria-hidden="true">
          {monogramUrl ? (
            <img src={monogramUrl} alt={hero.monogram?.alt ?? ''} class="monogram-img" />
          ) : (
            <svg viewBox="0 0 100 100" class="monogram-fallback" role="img" aria-label="Festival monogram">
              <path
                d="M50 2 L61 12 L75 8 L77 22 L90 28 L84 41 L90 54 L77 60 L75 74 L61 70 L50 80 L39 70 L25 74 L23 60 L10 54 L16 41 L10 28 L23 22 L25 8 L39 12 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linejoin="round"
              />
              <text x="50" y="58" text-anchor="middle" font-family="Playfair Display, serif" font-size="30" font-weight="700" fill="currentColor">ER</text>
            </svg>
          )}
        </span>

        <span class="meta-text">{hero.location}</span>
      </div>

      <h1 class="hero-title">{hero.title}</h1>

      {hero.body && (
        <div class="hero-body">
          <PortableText value={hero.body} />
        </div>
      )}

      <span class="hero-botanical" aria-hidden="true">
        {botanicalUrl ? (
          <img src={botanicalUrl} alt={hero.botanicalIllustration?.alt ?? ''} class="botanical-img" />
        ) : (
          <svg viewBox="0 0 120 80" class="botanical-fallback" role="img" aria-label="Botanical illustration">
            <path d="M60 72 V28" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M60 40 C50 38 42 30 42 22 C52 24 58 30 60 40" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M60 40 C70 38 78 30 78 22 C68 24 62 30 60 40" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M60 54 C48 52 38 44 38 34 C50 36 56 44 60 54" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M60 54 C72 52 82 44 82 34 C70 36 64 44 60 54" fill="none" stroke="currentColor" stroke-width="1" />
            <circle cx="60" cy="22" r="6" fill="none" stroke="currentColor" stroke-width="1" />
            <circle cx="60" cy="22" r="2" fill="currentColor" />
            <path d="M60 72 C54 68 48 68 44 72" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M60 72 C66 68 72 68 76 72" fill="none" stroke="currentColor" stroke-width="1" />
          </svg>
        )}
      </span>

      {hero.quote && (
        <p class="hero-quote">&ldquo;{hero.quote}&rdquo;</p>
      )}
    </main>

    <footer class="site-footer">
      {contactEmail ? (
        <a href={`mailto:${contactEmail}`} class="footer-email">{contactEmail}</a>
      ) : (
        <span class="footer-email">{contactEmail}</span>
      )}
    </footer>

    <style is:global>
      :root {
        --color-bg: #ede8dc;
        --color-surface: #4b5e43;
        --color-text: #1c1917;
        --color-muted: #57534e;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: 'Special Elite', 'Courier Prime', monospace;
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .site-header {
        background-color: var(--color-surface);
        width: 100%;
      }

      .header-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        padding: 0.85rem 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .header-link {
        font-family: 'Archivo', sans-serif;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-bg);
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 0.2s ease;
      }

      a.header-link:hover {
        opacity: 0.7;
      }

      .header-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--color-bg);
        width: 36px;
        height: 36px;
        flex-shrink: 0;
      }

      .badge-img {
        width: 36px;
        height: 36px;
        object-fit: contain;
      }

      .badge-fallback {
        width: 100%;
        height: 100%;
      }

      .hero {
        max-width: 820px;
        margin: 0 auto;
        padding: 4.5rem 3rem 5rem;
        text-align: center;
      }

      .hero-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 3rem;
        flex-wrap: nowrap;
      }

      .meta-text {
        font-family: 'Archivo', sans-serif;
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-text);
        white-space: nowrap;
      }

      .hero-monogram {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        color: var(--color-text);
      }

      .monogram-img {
        width: 72px;
        height: 72px;
        object-fit: contain;
      }

      .monogram-fallback {
        width: 100%;
        height: 100%;
      }

      .hero-title {
        font-family: 'Playfair Display', 'Times New Roman', serif;
        font-weight: 800;
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        color: var(--color-text);
        margin-bottom: 2.5rem;
        white-space: pre-line;
      }

      .hero-body {
        max-width: 560px;
        margin: 0 auto;
        font-family: 'Special Elite', 'Courier Prime', monospace;
        font-size: 1rem;
        line-height: 1.8;
        color: var(--color-text);
      }

      .hero-body :global(p) {
        margin-bottom: 1.2em;
      }

      .hero-body :global(p:last-child) {
        margin-bottom: 0;
      }

      .hero-botanical {
        display: block;
        margin: 3rem auto 2.5rem;
        width: 90px;
        height: 60px;
        color: var(--color-text);
      }

      .botanical-img {
        width: 90px;
        height: 60px;
        object-fit: contain;
      }

      .botanical-fallback {
        width: 100%;
        height: 100%;
      }

      .hero-quote {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-weight: 700;
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        line-height: 1.3;
        color: var(--color-text);
      }

      .site-footer {
        padding: 2.5rem 1.5rem 3rem;
        text-align: center;
      }

      .footer-email {
        font-family: 'Archivo', sans-serif;
        font-weight: 600;
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-text);
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      a.footer-email:hover {
        opacity: 0.7;
      }

      @media (max-width: 600px) {
        .hero {
          padding: 3rem 1.25rem 3.5rem;
        }
        .hero-meta {
          gap: 1rem;
          flex-wrap: wrap;
        }
        .hero-monogram {
          order: -1;
          width: 100%;
          margin-bottom: 0.5rem;
        }
        .header-nav {
          gap: 1.25rem;
        }
      }
    </style>
  </body>
</html>
