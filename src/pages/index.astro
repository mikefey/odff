---
import { getSiteSettings } from '../utils/sanity';
import { PortableText } from 'astro-portabletext';

const settings = await getSiteSettings();

const header = settings?.header ?? {};
const hero = settings?.hero ?? {};
const footer = settings?.footer ?? {};

const buyTicketsLabel = header.buyTicketsLabel || 'BUY TICKETS';
const buyTicketsUrl = header.buyTicketsUrl || 'https://www.ojaiplayhouse.com/';
const bookRoomLabel = header.bookRoomLabel || 'BOOK A ROOM';
const bookRoomUrl = header.bookRoomUrl || 'https://theroblar.com/';

const dateRange = hero.dateRange || 'OCTOBER 27 – 31';
const location = hero.location || 'OJAI, CALIFORNIA';
const title = hero.title ?? 'Ojai Documentary\nFilm Festival';
const contactEmail = footer.contactEmail || 'CONNECT@OJAIDOCUMENTARYFILMFESTIVAL.COM';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <link rel="icon" type="image/png" href="/star-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{String(title).replace(/\n/g, ' ')}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={String(title).replace(/\n/g, ' ')} />
    <meta property="og:description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <meta property="og:image" content="/odff-main-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={String(title).replace(/\n/g, ' ')} />
    <meta name="twitter:description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <meta name="twitter:image" content="/odff-main-logo.png" />
  </head>
  <body>
    <header class="site-header">
      <nav class="header-nav">
        {buyTicketsUrl ? (
          <a href={buyTicketsUrl} class="header-link" target="_blank" rel="noopener">
            {buyTicketsLabel}
          </a>
        ) : (
          <span class="header-link">{buyTicketsLabel}</span>
        )}

        <img src="/star-icon.png" alt="" class="header-star" aria-hidden="true" />

        {bookRoomUrl ? (
          <a href={bookRoomUrl} class="header-link" target="_blank" rel="noopener">
            {bookRoomLabel}
          </a>
        ) : (
          <span class="header-link">{bookRoomLabel}</span>
        )}
      </nav>
    </header>

    <main class="hero">
      <img src="/odff-main-logo.png" alt="Ojai Documentary Film Festival — October 27-31, Ojai, California" class="hero-logo" />

      {hero.body && (
        <div class="hero-body">
          <PortableText value={hero.body} />
        </div>
      )}

      <img src="/odff-best-fest.png" alt="Best Fest in the West" class="hero-emblem" />
    </main>

    <footer class="site-footer">
      {contactEmail ? (
        <a href={`mailto:${contactEmail}`} class="footer-email">{contactEmail}</a>
      ) : (
        <span class="footer-email">{contactEmail}</span>
      )}
    </footer>

    <style is:global>
      @font-face {
        font-family: 'TAYCardano';
        src: url('/fonts/TAYCardano.woff') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --color-bg: #F8ECCE;
        --color-header: #A6B6A0;
        --color-header-text: #F8ECCE;
        --color-text: #000000;
        --font-display: 'TAYCardano', 'Times New Roman', serif;
        --font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .site-header {
        background-color: var(--color-header);
        width: 100%;
        height: 50px;
      }

      .header-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        height: 100%;
        padding: 0 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .header-link {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.375rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-header-text);
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease-out;
      }

      a.header-link:hover {
        color: #000000;
      }

      .header-star {
        display: block;
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        object-fit: contain;
      }

      .hero {
        max-width: 1100px;
        margin: 0 auto;
        padding: 4rem 2rem 3.5rem;
        text-align: center;
      }

      .hero-logo {
        width: 100%;
        max-width: 674px;
        height: auto;
        object-fit: contain;
        margin: 0 auto 4rem;
        display: block;
      }

      .hero-body {
        max-width: 663px;
        margin: 0 auto;
        text-align: left;
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--color-text);
      }

      .hero-body :global(p) {
        margin-bottom: 1.2em;
      }

      .hero-body :global(p:last-child) {
        margin-bottom: 0;
      }

      .hero-emblem {
        display: block;
        width: 100%;
        max-width: 494px;
        height: auto;
        object-fit: contain;
        margin: 2.75rem auto 0;
      }

      .site-footer {
        padding: 4rem 1.5rem 4rem;
        text-align: center;
      }

      .footer-email {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.375rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text);
        text-decoration-line: underline;
        text-decoration-style: solid;
        text-decoration-skip-ink: auto;
        text-decoration-thickness: auto;
        text-underline-offset: auto;
        text-underline-position: from-font;
        transition: color 0.2s ease-out;
      }

      a.footer-email:hover {
        color: var(--color-header);
      }

      @media (max-width: 640px) {
        .hero {
          padding: 1.7rem 1.5rem 2.5rem;
        }
        .hero-logo {
          margin-bottom: 1.5rem;
        }
        .header-nav {
          gap: 0.75rem;
        }
        .header-link {
          font-size: 1.125rem;
        }
        .header-star {
          width: 20px;
          height: 20px;
        }
        .hero-body {
          font-size: 1rem;
        }
        .hero-emblem {
          margin-top: 2.5rem;
          max-width: 264px;
        }
        .footer-email {
          font-size: 0.75rem;
          letter-spacing: 0.05em;
        }
        .site-footer {
          padding-top: 1.5rem;
        }
      }
    </style>
  </body>
</html>
