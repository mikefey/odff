---
import { getSiteSettings } from '../utils/sanity';
import { PortableText } from 'astro-portabletext';

const settings = await getSiteSettings();

const header = settings?.header ?? {};
const hero = settings?.hero ?? {};
const footer = settings?.footer ?? {};

const buyTicketsLabel = header.buyTicketsLabel || 'BUY TICKETS';
const buyTicketsUrl = header.buyTicketsUrl || 'https://www.ojaiplayhouse.com/';
const bookRoomLabel = header.bookRoomLabel || 'BOOK A ROOM';
const bookRoomUrl = header.bookRoomUrl || 'https://atpscan.msp.proofpoint.com/?d=07Me8axVNsYk14ERKBvxeXiB1MsKOQv_ekiQVzyiG9c&f=kmGL3MVNdE_ZQJCeFO4bk3OwxLd3v1iH0IOFs71AdBsrvGdTAdZzdxIH8QHZHdA1&i=&k=BS91&m=B9f9yOjQQUHyzE-eH4lupq3S3yDBPIeqe4LhgLxjfdjZ5QF54yNFK2ZhjLRZ-jysTQh_6PHZn2qhdCKZHbmMXG5Zeqy3WyPEpbX6rVLBSwDTGN8G4hERP0GDdb7lwKol&n=Iu9xyHUa3erwK-N2Cwt_REhi0QLCQAvmvw9hdJkL8M_7eZn4l8a8F9S2H7boX3CQ&r=m3m76g3BcQaTRTnOYIIQpLo9Fyt5_YL480r-VfI214U-vrj8vwXjYXyOcgdjCC4B&s=42962907a272afd69fd225ef29f46e7099cb332dd69bd1b4a854a3131fbead4f&u=https%3A%2F%2Fbe.synxis.com%2F%3F%26amp%3Bchain%3D24447%26amp%3Bhotel%3D98714%26amp%3BSRC%3D30%26amp%3Bpromo%3DODFF%26amp%3Barrive%3D2026-10-27%26amp%3Bnights%3D1';
const headerBadgeUrl = header.headerBadge?.asset?.url || '/star-icon.png';
const headerBadgeAlt = header.headerBadge?.alt || '';

const logoUrl = hero.logo?.asset?.url || '/odff-main-logo.png';
const logoAlt = hero.logo?.alt || 'Ojai Documentary Film Festival — October 26–30, Ojai, California. Presented by Hotel El Roblar & Ojai Playhouse.';

const fallbackHeroImages = ['01', '02', '03', '04', '05', '07', '08'].map((n) => ({
  asset: { url: `/hero/hero-${n}.png` },
  alt: '',
}));
const heroImages = hero.images?.length ? hero.images : fallbackHeroImages;

const badgeLabel = footer.badgeLabel || 'Best Fest of the West';
const badgeIllustrationUrl = footer.badgeIllustration?.asset?.url || '/odff-best-fest.png';
const badgeIllustrationAlt = footer.badgeIllustration?.alt || badgeLabel;
const contactLabel = footer.contactLabel || 'Inquiries';
const contactEmail = footer.contactEmail || 'CONNECT@OJAIDOCUMENTARYFILMFESTIVAL.COM';

const fallbackBodyText =
  "The Ojai Documentary Film Festival presented by Hotel El Roblar and the Ojai Playhouse Theater will take place October 27–30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect. Together, we explore nonfiction storytelling from vérité and hybrid forms to the wholly unclassifiable, spanning the contemporary and the nostalgic, transforming real life into cinema that's anything but boring.";

const fallbackSchedule = [
  {
    dayLabel: 'Monday, October 26',
    screenings: [
      { time: '1–4 PM', title: 'The Story of Documentary Film' },
      { time: '5–9 PM', title: 'Musk' },
    ],
  },
  {
    dayLabel: 'Tuesday, October 27',
    screenings: [
      { time: '12 PM', title: 'Punishment Park', note: 'Q&A with director Joan Churchill' },
      { time: '2:30 PM', title: 'Rehearsals for a Revolution' },
      { time: '4:30 PM', title: 'Everest: The Other Side' },
      { time: '7 PM', title: 'Nuisance Bear', note: 'Q&A with directors Jack Weisman & Joan Churchill' },
    ],
  },
  {
    dayLabel: 'Wednesday, October 28',
    screenings: [
      { time: '2:30 PM', title: 'Remake' },
      { time: '4:30 PM', title: 'Bend in the River', note: 'Q&A with directors Robb Moss & Lauren Greenfield' },
      { time: '7:30 PM', title: 'Basquiat' },
      { time: '9:15 PM', title: 'Wild Combination: A Portrait of Arthur Russell', note: 'Intro by director Matt Wolf' },
    ],
  },
  {
    dayLabel: 'Thursday, October 29',
    screenings: [
      { time: '12:00 PM', title: 'Queen of Versailles', note: 'Q&A with director Lauren Greenfield' },
      { time: '2:00 PM', title: 'Barbara Forever' },
      { time: '4:15 PM', title: 'History of Concrete' },
      { time: '7:00 PM', title: 'You Can See Everything' },
    ],
  },
  {
    dayLabel: 'Friday, October 30',
    screenings: [
      { time: '12:00 PM', title: 'Some Kind of Heaven' },
      { time: '2:15 PM', title: 'Soul Patrol' },
      { time: '5:00 PM', title: 'Once Upon a Time in Harlem' },
      { time: '7:30 PM', title: 'The Best Summer', note: 'Q&A with director Tamra Davis' },
    ],
  },
];

const schedule = settings?.schedule?.length ? settings.schedule : fallbackSchedule;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <link rel="icon" type="image/png" href="/star-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Ojai Documentary Film Festival</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ojai Documentary Film Festival" />
    <meta property="og:description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <meta property="og:image" content="/odff-main-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ojai Documentary Film Festival" />
    <meta name="twitter:description" content="The Ojai Documentary Film Festival Presented by Hotel El Roblar at the Ojai Playhouse Theater will take place October 27-30, bringing together visionary documentary films and series, in-person conversations, and experiences that invite audiences and filmmakers to connect." />
    <meta name="twitter:image" content="/odff-main-logo.png" />
  </head>
  <body>
    <header class="topbar">
      <nav class="topbar-nav">
        {buyTicketsUrl ? (
          <a href={buyTicketsUrl} class="topbar-link" target="_blank" rel="noopener">
            {buyTicketsLabel}
          </a>
        ) : (
          <span class="topbar-link">{buyTicketsLabel}</span>
        )}

        <img src={headerBadgeUrl} alt={headerBadgeAlt} class="topbar-star" aria-hidden={!headerBadgeAlt} />

        {bookRoomUrl ? (
          <a href={bookRoomUrl} class="topbar-link" target="_blank" rel="noopener">
            {bookRoomLabel}
          </a>
        ) : (
          <span class="topbar-link">{bookRoomLabel}</span>
        )}
      </nav>
    </header>

    <main>
      <section class="festival-logo">
        <img src={logoUrl} alt={logoAlt} class="festival-logo-img" />
      </section>

      <section class="hero-carousel" data-carousel>
        {heroImages.map((image: any, i: number) => (
          <img
            src={image.asset?.url}
            alt={image.alt || ''}
            class="hero-carousel-slide"
            data-active={i === 0 ? 'true' : 'false'}
          />
        ))}

        {heroImages.length > 1 && (
          <div class="hero-carousel-dots">
            {heroImages.map((_: any, i: number) => (
              <button
                type="button"
                class="hero-carousel-dot"
                data-index={i}
                aria-label={`Show photo ${i + 1}`}
              />
            ))}
          </div>
        )}
      </section>

      <section class="description">
        {hero.body ? <PortableText value={hero.body} /> : <p>{fallbackBodyText}</p>}
      </section>

      <section class="schedule">
        <h2 class="schedule-heading">Schedule</h2>

        {schedule.map((day: any) => (
          <div class="schedule-day">
            <div class="schedule-rule schedule-rule-top"></div>
            <h3 class="schedule-day-label">{day.dayLabel}</h3>
            <div class="schedule-rule schedule-rule-bottom"></div>

            {day.screenings?.map((screening: any) => (
              <div class="screening">
                <p class="screening-time">{screening.time}</p>
                {screening.url ? (
                  <a href={screening.url} class="screening-title" target="_blank" rel="noopener">
                    {screening.title}
                  </a>
                ) : (
                  <p class="screening-title">{screening.title}</p>
                )}
                {screening.note && <p class="screening-note">{screening.note}</p>}
              </div>
            ))}
          </div>
        ))}
      </section>
    </main>

    <footer class="site-footer">
      <img src={badgeIllustrationUrl} alt={badgeIllustrationAlt} class="footer-badge" />

      {contactEmail ? (
        <a href={`mailto:${contactEmail}`} class="footer-email">{contactLabel}</a>
      ) : (
        <span class="footer-email">{contactLabel}</span>
      )}
    </footer>

    <style is:global>
      @font-face {
        font-family: 'TAY Cardano';
        src: url('/fonts/TAYCardano.woff') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'VC Garamond Condensed Trial';
        src: url('/fonts/GaramondCondensedTrial-Regular.otf') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'EB Garamond';
        src: url('/fonts/EBGaramond-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --color-bg: #f8ecce;
        --color-cream: #f8ecce;
        --color-accent-red: #c54b31;
        --color-text: #000000;
        --font-tay: 'TAY Cardano', 'Times New Roman', serif;
        --font-condensed: 'VC Garamond Condensed Trial', Georgia, serif;
        --font-serif: 'EB Garamond', Garamond, Georgia, serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-tay);
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      /* Top bar */
      .topbar {
        background-color: var(--color-accent-red);
        width: 100%;
        min-height: 50px;
      }

      .topbar-nav {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        justify-items: center;
        gap: 1rem;
        min-height: 50px;
        padding: 0.5rem 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .topbar-nav > :first-child {
        justify-self: end;
      }

      .topbar-nav > :last-child {
        justify-self: start;
      }

      .topbar-link {
        font-family: var(--font-tay);
        font-weight: 400;
        font-size: 1.375rem;
        letter-spacing: 0.1em;
        color: var(--color-text);
        text-decoration: none;
        white-space: nowrap;
        padding: 0.25rem 0.75rem;
        transition: color 0.2s ease-out;
      }

      a.topbar-link:hover {
        color: var(--color-cream);
      }

      .topbar-star {
        display: block;
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        object-fit: contain;
      }

      /* Festival logo */
      .festival-logo {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.5rem 2rem 0;
        text-align: center;
      }

      .festival-logo-img {
        width: 100%;
        max-width: 600px;
        height: auto;
        margin: 0 auto;
        display: block;
      }

      /* Hero carousel */
      .hero-carousel {
        position: relative;
        width: 100%;
        max-width: 1000px;
        aspect-ratio: 1600 / 1100;
        overflow: hidden;
        margin: 2rem auto 0;
        background-color: var(--color-accent-red);
        background-color: color-mix(in srgb, var(--color-accent-red) 20%, var(--color-bg));
      }

      .hero-carousel-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1.2s ease;
      }

      .hero-carousel-slide[data-active='true'] {
        opacity: 1;
      }

      .hero-carousel-dots {
        position: absolute;
        left: 50%;
        bottom: 1.25rem;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        z-index: 2;
      }

      .hero-carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 1px solid var(--color-cream);
        background-color: transparent;
        padding: 0;
        cursor: pointer;
        transition: background-color 0.2s ease-out;
      }

      .hero-carousel-dot[data-active='true'] {
        background-color: var(--color-cream);
      }

      /* Description */
      .description {
        max-width: 663px;
        margin: 3rem auto 0;
        padding: 0 2rem;
        text-align: center;
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: 1.5rem;
        line-height: 1.6;
      }

      .description p {
        margin-bottom: 1.2em;
      }

      .description p:last-child {
        margin-bottom: 0;
      }

      /* Schedule */
      .schedule {
        max-width: 700px;
        margin: 0 auto;
        padding: 3.5rem 2rem 3.5rem;
        text-align: center;
      }

      .schedule-heading {
        font-family: var(--font-condensed);
        font-weight: 400;
        font-size: 3rem;
        line-height: 0.94;
        margin-bottom: 1rem;
      }

      .schedule-day {
        margin-bottom: 0;
      }

      .schedule-rule {
        width: 100%;
        height: 2px;
        background-color: var(--color-accent-red);
      }

      .schedule-rule-top {
        margin-bottom: 1rem;
      }

      .schedule-day-label {
        font-family: var(--font-tay);
        font-weight: 400;
        font-size: 1.25rem;
        color: var(--color-accent-red);
        margin-bottom: 0.75rem;
      }

      .schedule-rule-bottom {
        margin-bottom: 2.75rem;
      }

      .screening {
        margin-bottom: 3.5rem;
      }

      .screening-time {
        font-family: var(--font-tay);
        font-weight: 400;
        font-size: 1.25rem;
        color: var(--color-accent-red);
        margin-bottom: 1.25rem;
      }

      p.screening-title,
      a.screening-title {
        display: inline-block;
        font-family: var(--font-condensed);
        font-weight: 400;
        font-size: 3rem;
        line-height: 0.94;
        color: var(--color-text);
        text-decoration: none;
      }

      a.screening-title:hover {
        text-decoration: underline;
      }

      .screening-note {
        margin-top: 1.25rem;
        font-family: var(--font-tay);
        font-weight: 400;
        font-size: 1.25rem;
        color: var(--color-accent-red);
      }

      /* Footer */
      .site-footer {
        padding: 3rem 1.5rem 3.5rem;
        text-align: center;
      }

      .footer-badge {
        display: block;
        width: 100%;
        max-width: 320px;
        height: auto;
        object-fit: contain;
        margin: 0 auto 1.5rem;
      }

      .footer-email {
        font-family: var(--font-tay);
        font-weight: 400;
        font-size: 1.375rem;
        letter-spacing: 0.1em;
        color: var(--color-text);
        text-decoration-line: underline;
        text-decoration-style: solid;
        text-decoration-skip-ink: auto;
        text-decoration-thickness: auto;
        text-underline-offset: auto;
        text-underline-position: from-font;
        transition: color 0.2s ease-out;
      }

      a.footer-email:hover {
        color: var(--color-accent-red);
      }

      @media (max-width: 640px) {
        .festival-logo {
          padding: 1.75rem 1.5rem 0;
        }
        .festival-logo-img {
          max-width: 320px;
        }
        .hero-carousel {
          margin-top: 1.5rem;
        }
        .description {
          font-size: 1.125rem;
          margin-top: 2rem;
        }
        .topbar-nav {
          gap: 0.5rem;
          padding: 0.5rem 0.75rem;
        }
        .topbar-link {
          font-size: 0.9375rem;
          padding: 0.25rem 0.5rem;
          white-space: normal;
          overflow-wrap: break-word;
          text-align: center;
        }
        .topbar-star {
          width: 16px;
          height: 16px;
        }
        .schedule {
          padding: 2.5rem 1.5rem 2.5rem;
        }
        .schedule-heading {
          font-size: 2.25rem;
        }
        .schedule-rule-bottom {
          margin-bottom: 2rem;
        }
        .screening {
          margin-bottom: 2.25rem;
        }
        .screening-time {
          margin-bottom: 1rem;
        }
        .screening-note {
          margin-top: 1rem;
        }
        p.screening-title,
        a.screening-title {
          font-size: 2rem;
        }
        .footer-badge {
          max-width: 220px;
        }
        .footer-email {
          font-size: 0.9375rem;
          letter-spacing: 0.05em;
        }
      }

      @media (max-width: 400px) {
        .topbar-nav {
          gap: 0.375rem;
          padding: 0.5rem 0.5rem;
        }
        .topbar-link {
          font-size: 0.75rem;
          letter-spacing: 0.05em;
          padding: 0.25rem 0.25rem;
        }
        .topbar-star {
          width: 14px;
          height: 14px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-carousel-slide {
          transition: none;
        }
      }
    </style>

    <script>
      document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-carousel-slide'));
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-carousel-dot'));
        if (slides.length <= 1) return;

        let index = 0;
        let timer: ReturnType<typeof setInterval>;

        function show(next: number) {
          index = next;
          slides.forEach((slide, i) => slide.setAttribute('data-active', String(i === index)));
          dots.forEach((dot, i) => dot.setAttribute('data-active', String(i === index)));
        }

        function restart() {
          clearInterval(timer);
          timer = setInterval(() => show((index + 1) % slides.length), 5000);
        }

        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            show(i);
            restart();
          });
        });

        show(0);
        restart();
      });
    </script>
  </body>
</html>
